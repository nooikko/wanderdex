{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wanderdex Setup",
  "mainBinaryName": "wanderdex-setup",
  "version": "../../package.json",
  "identifier": "io.github.wanderdex.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wanderdex Setup",
        "width": 640,
        "height": 400,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ]
  }
}
